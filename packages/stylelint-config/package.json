{
  "name": "@1stg/stylelint-config",
  "version": "7.0.0",
  "description": "Personal but Shareable Stylelint Configuration for all 1stG.me projects",
  "homepage": "https://github.com/1stG/configs/tree/master/packages/stylelint-config",
  "license": "MIT",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "repository": "git+https://github.com/1stG/configs.git",
  "funding": "https://opencollective.com/configs",
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
