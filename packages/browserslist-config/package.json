{
  "name": "@1stg/browserslist-config",
  "version": "2.1.4",
  "type": "commonjs",
  "description": "Personal but Shareable Browserslist Configuration for all 1stG.me projects",
  "repository": "git+https://github.com/1stG/configs.git",
  "homepage": "https://github.com/1stG/configs/tree/master/packages/browserslist-config",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "funding": "https://opencollective.com/configs",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./latest": {
      "types": "./lib/latest.d.ts",
      "require": "./lib/latest.js",
      "default": "./lib/latest.js"
    },
    "./modern": {
      "types": "./lib/modern.d.ts",
      "require": "./lib/modern.js",
      "default": "./lib/modern.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "MIGRATION.md",
    "lib",
    "README.md"
  ],
  "peerDependencies": {
    "browserslist": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
