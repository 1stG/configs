{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "lib",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "tsBuildInfoFile": "lib/tsconfig.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
