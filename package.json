{
  "name": "@1stg/configs",
  "version": "0.0.0",
  "type": "module",
  "description": "Personal but Shareable Configurations for all 1stG.me projects",
  "repository": "git+https://github.com/1stG/configs.git",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "precheck": "yarn build",
    "check": "yarn format:check",
    "clean": "tsc -b --clean tsconfig.build.json",
    "preformat": "yarn build",
    "format": "run-p format:ox format:prettier",
    "format:check": "run-p 'format:*:check'",
    "format:ox": "oxfmt .",
    "format:ox:check": "yarn format:ox --check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "yarn format:prettier --check",
    "prelint": "yarn build",
    "lint": "run-p 'lint:*'",
    "lint:eslint": "eslint .",
    "lint:ox": "oxlint .",
    "lint:style": "stylelint . --cache",
    "lint:tsc": "tsc --noEmit",
    "prepare": "patch-package && simple-git-hooks && yarn-berry-deduplicate && yarn build",
    "release": "yarn build && changeset publish",
    "pretest": "yarn build",
    "test": "vitest run",
    "typecov": "type-coverage",
    "version": "changeset version && yarn --no-immutable"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.2",
    "@prettier/plugin-pug": "^3.4.2",
    "@prettier/plugin-ruby": "^4.0.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/unist": "^3.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unts/patch-package": "^8.1.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^9.39.4 || ^10.0.1",
    "eslint-plugin-markup": "^2.1.0",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-yml": "^3.9.0",
    "markuplint": "^5.0.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.15",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.0",
    "prettier-plugin-stylus": "^0.1.0",
    "react": "^19.2.6",
    "rxjs": "^7.8.2",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.12.0",
    "type-coverage": "^2.29.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3",
    "yarn-berry-deduplicate": "^7.1.0"
  },
  "resolutions": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreCatch": true,
    "ignoreFiles": "*.d.ts",
    "ignoreNonNullAssertion": true,
    "strict": true
  }
}
